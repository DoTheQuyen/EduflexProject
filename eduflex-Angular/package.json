  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:spa": "ng serve",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "ng build",
    "start:ssr": "ng build && node dist/eduflex-Angular/server/server.mjs",
