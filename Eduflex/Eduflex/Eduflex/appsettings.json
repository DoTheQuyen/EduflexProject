{
  "ConnectionStrings": {
    "MongoDBConnection": "mongodb://localhost:27017"
  },
  "MongoDBSettings": {
    "DatabaseName": "EduflexDB"
  },
  "JWT": {
    "Secret": "your-super-secret-jwt-key-here-minimum-32-characters",
    "Salt": "your-password-salt-here"
  },
  "Cors": {
    "Policies": {
      "AllowAngular": {
        "Origins": [
          "http://localhost:4200",
          "http://localhost:9000"
        ],
        "AllowHeaders": "*",
        "AllowMethods": "*",
        "AllowCredentials": true
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}