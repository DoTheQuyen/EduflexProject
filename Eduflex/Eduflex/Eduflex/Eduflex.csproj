<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cdc7f369-8001-48c4-9d25-6a69c9e01a5b</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>
	<PropertyGroup>
		<Company>Quyen The Do</Company>
		<Authors>Quyen The Do</Authors>
		<Copyright>Copyright © 2025 Quyen The Do. All rights reserved.</Copyright>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	</PropertyGroup>
  <ItemGroup>
    <Compile Remove="Test\**" />
    <Content Remove="Test\**" />
    <EmbeddedResource Remove="Test\**" />
    <None Remove="Test\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.9" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="MongoDB.Bson" Version="3.5.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.5.0" />
    <PackageReference Include="MongoDB.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.6.0" />
    <PackageReference Include="NSwag.Generation.AspNetCore" Version="14.6.0" />
    <PackageReference Include="NSwag.MSBuild" Version="14.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
    <PackageReference Include="System.Linq" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShareService\ShareService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="NewFolder\" />
  </ItemGroup>

	<Target Name="ExportSwagger" AfterTargets="Build" Condition="'$(BuildingInsideDocker)' != 'true'">
		<Exec Command="dotnet swagger tofile --output &quot;$(ProjectDir)swagger-auth.json&quot; &quot;$(TargetPath)&quot; auth" ContinueOnError="WarnAndContinue" />
		<Exec Command="dotnet swagger tofile --output &quot;$(ProjectDir)swagger-public.json&quot; &quot;$(TargetPath)&quot; public" ContinueOnError="WarnAndContinue" />
		<Exec Command="dotnet swagger tofile --output &quot;$(ProjectDir)swagger-app.json&quot;  &quot;$(TargetPath)&quot; app" ContinueOnError="WarnAndContinue" />
	</Target>

	<Target Name="NSwagAuth" AfterTargets="ExportSwagger" Condition="'$(BuildingInsideDocker)' != 'true'">
		<Exec Condition="Exists('$(ProjectDir)swagger-auth.json') AND Exists('$(ProjectDir)nswag.auth.json')" Command="nswag run &quot;$(ProjectDir)nswag.auth.json&quot;" />
	</Target>

	<Target Name="NSwagPublic" AfterTargets="ExportSwagger" Condition="'$(BuildingInsideDocker)' != 'true'">
		<Exec Condition="Exists('$(ProjectDir)swagger-public.json') AND Exists('$(ProjectDir)nswag.public.json')" Command="nswag run &quot;$(ProjectDir)nswag.public.json&quot;" />
	</Target>

	<Target Name="NSwagApp" AfterTargets="ExportSwagger" Condition="'$(BuildingInsideDocker)' != 'true'">
		<Exec Condition="Exists('$(ProjectDir)swagger-app.json') AND Exists('$(ProjectDir)nswag.app.json')" Command="nswag run &quot;$(ProjectDir)nswag.app.json&quot;" />
	</Target>

</Project>

