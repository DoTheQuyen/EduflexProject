{
   "//": "index.html stays uncached so it always points at the latest chunk hashes; js/css get long-lived caching since their filenames change on every build",
   
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,scss,js,png,gif,jpg,jpeg,svg,ico,json,woff,woff2,ttf}"]
  },
  "globalHeaders": {
    "Cache-Control": "no-cache, must-revalidate"
  },
  "routes": [
    {
      "route": "/*.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.css",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
